# Copy to .env. Never commit real keys.
OPSPILOT_STAGE=local
OPSPILOT_LLM_PROVIDER=offline        # offline | anthropic | bedrock
OPSPILOT_MODEL=claude-sonnet-5       # on Bedrock, use the Bedrock model ID
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
OPSPILOT_EMBEDDER=hashing            # hashing | sentence-transformers
OPSPILOT_INDEX=memory                # memory | postgres
DATABASE_URL=
